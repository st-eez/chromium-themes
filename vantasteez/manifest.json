      "toolbar": [13, 13, 13],
      "tab_text": [234, 234, 234],
      "tab_background_text": [138, 138, 138],
      "bookmark_text": [234, 234, 234],

      "ntp_background": [13, 13, 13],
      "ntp_text": [234, 234, 234],
      "ntp_link": [234, 234, 234],
      "ntp_section": [13, 13, 13],

      "omnibox_background": [13, 13, 13],
      "omnibox_text": [234, 234, 234],

      "omnibox_popup_background": [13, 13, 13],
      "omnibox_popup_border": [13, 13, 13],
      "omnibox_popup_text": [234, 234, 234],
      "omnibox_popup_highlight": [42, 42, 42],
      "omnibox_popup_highlight_text": [234, 234, 234]
