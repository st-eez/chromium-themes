{
  "manifest_version": 3,
  "name": "Vantasteez — Monochrome (Vantablack Style)",
  "version": "1.0.1",
  "description": "Vantasteez canonical palette adapted to a monochrome Chromium theme with Vantablack-style contrast for Helium 0.11.6+.",
  "theme": {
    "color_scheme": "dark",
    "colors": {
      "frame": [42, 42, 42],
